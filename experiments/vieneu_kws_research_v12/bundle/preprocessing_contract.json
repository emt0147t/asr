{
  "contract_name": "Vietnamese_KWS_Preprocessing_Contract_v12",
  "audio_input": {
    "sample_rate_hz": 16000,
    "channels": 1,
    "format": "PCM_FLOAT32",
    "duration_seconds": 1.0,
    "num_samples": 16000,
    "peak_normalization": {
      "enabled": true,
      "target_peak_dbfs": -1.0,
      "target_peak_amplitude": 0.8912509381337456
    },
    "crop_pad_policy": "center_speech_or_pad_zeros"
  },
  "log_mel_spectrogram": {
    "sample_rate": 16000,
    "n_fft": 512,
    "win_length": 400,
    "hop_length": 160,
    "window_type": "hann",
    "center": true,
    "pad_mode": "reflect",
    "power": 2.0,
    "n_mels": 40,
    "f_min_hz": 20.0,
    "f_max_hz": 8000.0,
    "norm": "slaney",
    "mel_scale": "slaney",
    "log_compression_eps": 1e-06,
    "output_tensor_shape": [1, 1, 40, 101]
  },
  "decision_logic": {
    "num_classes": 5,
    "class_order": ["TRAI", "PHAI", "LEN", "XUONG", "REJECT"],
    "calibrated_theta_cmd": 0.20,
    "rule": "If max(prob[TRAI], prob[PHAI], prob[LEN], prob[XUONG]) >= theta_cmd then predict argmax command, else REJECT."
  }
}
